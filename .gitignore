# ======================================================================
# x86 Validation Suite .gitignore
# ======================================================================

# ----------------------------------------------------------------------
# Build Output & Artifacts
# ----------------------------------------------------------------------
/build/
/bin/
/obj/
*.obj
*.o
*.exe
*.com
*.bin
*.out
*.elf
*.so
*.dll
*.lib
*.a
*.lst
*.map
*.err
*.img
*.iso
X86VAL.EXE
X86VAL.LOG
x86val
x86val.exe

# ----------------------------------------------------------------------
# Assembler & C/C++ (NASM, OpenWatcom, GCC, MSVC)
# ----------------------------------------------------------------------
# Dependency files
*.d
# Precompiled headers
*.gch
*.pch
# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeScripts/
Testing/
Makefile.cmake
build.ninja

# ----------------------------------------------------------------------
# Python
# ----------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/

# ----------------------------------------------------------------------
# Verilog / VHDL (HDL Simulation & Synthesis)
# ----------------------------------------------------------------------
*.vcd
*.ghw
*.wlf
*.mti
*.mpf
*.bak
work/
transcript
vsim.wlf
*.jou
*.pb
*.str
*.cmd
.Xil/
# Altera / Intel Quartus
*.qws
*.rpt
*.smsg
*.summary
*.jdi
*.pin
*.sof
*.pof
*.sld
db/
incremental_db/
greybox_tmp/
simulation/
# timing/ — removed, conflicts with doc/specs/timing/

# ----------------------------------------------------------------------
# Scratch / Temporary Files
# ----------------------------------------------------------------------
**/scratch/

# ----------------------------------------------------------------------
# OS & Environment Files (macOS, Windows, Linux)
# ----------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
*.swp
*.swo

# ----------------------------------------------------------------------
# IDEs & Editors
# ----------------------------------------------------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vim/
tags
cscope.*
serial
build/
